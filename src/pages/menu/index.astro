const gallery = [
  { src: breakiePhoto, alt: "Poached eggs with hollandaise and spinach on toasted sourdough" },
  { src: chickenPhoto, alt: "Crispy chicken with slaw, herbs and a sticky glaze" },
  { src: fishAndChipsPhoto, alt: "Beer-battered fish and chips with lemon and salad leaves" },
  { src: cheesecakePhoto, alt: "A slice of cheesecake with berry compote and whipped cream" },
  { src: shakesPhoto, alt: "A chocolate milkshake topped with cream and banana" },
