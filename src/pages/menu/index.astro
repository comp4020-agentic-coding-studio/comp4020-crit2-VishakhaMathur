---

<BaseLayout title="Menu — Tilley's Devine Cafe Gallery" depth={1}>
  <section class="hero hero-band menu-hero" style={`background-image: url(${hallPhoto.src})`}>
    <h1>Menu</h1>
    <p class="tagline">Good food, great drinks &amp; good company</p>
    <div class="menu-photo-row">
      <Image
        src={breakfastPhoto}
        alt="A full breakfast plate of bacon, poached eggs, hashbrowns, sausage and toast"
        width={400}
        height={260}
      />
      <Image
        src={squidPhoto}
        alt="Golden crispy fried squid served with garden salad and a dipping sauce"
        width={400}
        height={260}
      />
      <Image
        src={foodPhoto}
        alt="Crispy fried chicken drizzled with sauce over slaw, garnished with coriander"
        width={400}
        height={260}
      />
    </div>
  </section>

  <p>
    Order at the bar, noting your table number. Fully licensed, strictly no
    BYO.
  </p>

  <div class="menu-layout">
    <div class="menu-columns">
      <section class="menu-section">
        <h2>Breakfast</h2>
        <ul class="price-list">
          {breakfast.map((item) => (
            <li>
              <span>
                {item.name}
                {item.note && <span class="item-note">{item.note}</span>}
              </span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
        <div class="callout-box">
          <p class="callout-title">Toast</p>
          <p>with jam, butter, vegemite or honey &mdash; <span class="price">6</span></p>
        </div>
      </section>

      <section class="menu-section">
        <h2>Lunch / dinner</h2>
        <ul class="price-list">
          {lunchDinner.map((item) => (
            <li>
              <span>{item.name}</span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="menu-sidebar">
      <div class="promo-card">
        <h2>Happy hour</h2>
        <p class="promo-time">Every Friday, 5:30pm&ndash;6:30pm</p>
        <p>House wines, beers &amp; select cocktails.</p>
      </div>

      <div class="quick-info band-dark">
        <h2>Dietary info</h2>
        <ul class="dietary-list">
          <li><span class="badge">V</span> Vegetarian</li>
          <li><span class="badge">VG</span> Vegan</li>
          <li><span class="badge">GF</span> Gluten free</li>
          <li><span class="badge">DF</span> Dairy free</li>
        </ul>
        <p>Please let our team know about any dietary needs.</p>
      </div>
    </aside>
  </div>

  <section class="menu-section">
    <h2>Sides</h2>
    <ul class="price-list">
      {sides.map((item) => (
        <li>
          <span>{item.name}</span>
          <span class="price">{item.price}</span>
        </li>
      ))}
    </ul>

    <h2>Drinks</h2>
    <p>
      Segafredo Organic coffee blend, poured since 1986, plus a full bar and a
      wine list from the Canberra region and beyond, by the glass or bottle.
    </p>
    <div class="drinks-grid">
      <div>
        <h3>Coffee</h3>
        <ul class="price-list">
          {coffee.map((item) => (
            <li>
              <span>{item.name}</span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Tea</h3>
        <ul class="price-list">
          {tea.map((item) => (
            <li>
              <span>{item.name}</span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Cold</h3>
        <ul class="price-list">
          {cold.map((item) => (
            <li>
              <span>
                {item.name}
                {item.note && <span class="item-note">{item.note}</span>}
              </span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Alcohol</h3>
        <ul class="price-list">
          {alcohol.map((item) => (
            <li>
              <span>{item.name}</span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <h2>Good to know</h2>
    <ul class="explore-list">
      <li>Order at the bar</li>
      <li>10% weekend surcharge</li>
      <li>Last kitchen orders 30 minutes before closing</li>
      <li>Thank you for supporting a local Canberra institution</li>
    </ul>
  </section>

  <div class="menu-gallery">
    {gallery.map((photo) => (
      <Image src={photo.src} alt={photo.alt} width={400} height={400} />
    ))}
  </div>
</BaseLayout>
