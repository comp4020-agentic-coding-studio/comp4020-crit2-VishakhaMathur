---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import hallPhoto from "../../../assets/hall.jpg";
import breakfastPhoto from "../../../assets/breakfast.jpg";
import squidPhoto from "../../../assets/squid.jpg";
import foodPhoto from "../../../assets/food.jpg";
import breakiePhoto from "../../../assets/breakie.jpg";
import chickenPhoto from "../../../assets/chicken.jpg";
import fishAndChipsPhoto from "../../../assets/fishandchips.jpg";
import cheesecakePhoto from "../../../assets/cheesecake.jpg";
import shakesPhoto from "../../../assets/shakes.jpg";

const breakfast = [
  { name: "Poached eggs", price: "15" },
  { name: "Fried eggs", price: "15" },
