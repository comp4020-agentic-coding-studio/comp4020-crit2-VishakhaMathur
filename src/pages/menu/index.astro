  { name: "Hashbrowns", price: "6" },
  { name: "French toast", price: "16" },
  { name: "Cheese & tomato toasty", price: "9" },
  { name: "Cheese & ham toasty", price: "9" },
];

const lunchDinner = [
  { name: "Caesar salad", price: "18" },
  { name: "Fish and chips", price: "24" },
  { name: "Fritters", price: "18" },
  { name: "Pork belly", price: "26" },
  { name: "Chicken parm", price: "26" },
  { name: "Okonomiyaki", price: "20" },
  { name: "Pie", price: "18" },
  { name: "Quiche", price: "18" },
  { name: "Squid", price: "22" },
  { name: "Dahl", price: "18" },
  { name: "Pizza", price: "20" },
  { name: "Tomato ravioli", price: "22" },
  { name: "Spaghetti", price: "20" },
  { name: "Rigatoni", price: "22" },
  { name: "Coos coos salad", price: "18" },
  { name: "Nachos", price: "18" },
];

const sides = [
  { name: "Spring rolls (4)", price: "12" },
  { name: "Potato fries", price: "8" },
  { name: "Sweet potato fries", price: "9" },
  { name: "Prawn twisters (4)", price: "12" },
  { name: "Chicken nuggets (6)", price: "10" },
  { name: "Hashbrowns (2)", price: "6" },
];

const coffee = [
  { name: "Espresso", price: "4.0" },
  { name: "Long black", price: "4.5" },
  { name: "Flat white", price: "4.7" },
  { name: "Cappuccino", price: "4.7" },
  { name: "Latte", price: "5.0" },
  { name: "Mocha", price: "5.5" },
  { name: "Macchiato", price: "4.2" },
];

const tea = [
  { name: "English breakfast", price: "4.5" },
  { name: "Earl grey", price: "4.5" },
  { name: "Green tea", price: "4.5" },
  { name: "Peppermint", price: "4.5" },
  { name: "Chamomile", price: "4.5" },
  { name: "Lemongrass & ginger", price: "4.5" },
  { name: "Chai latte", price: "5.0" },
];

const cold = [
  { name: "Iced coffee", price: "6.0" },
  { name: "Iced chocolate", price: "6.0" },
  { name: "Iced mocha", price: "6.0" },
  { name: "Milkshakes", price: "7.0", note: "chocolate, vanilla, strawberry, caramel" },
  { name: "Soft drinks", price: "4.5" },
  { name: "Juices", price: "5.0" },
];

