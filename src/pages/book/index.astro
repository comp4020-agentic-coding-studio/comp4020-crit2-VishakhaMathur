---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Book a table — Tilley's Devine Cafe Gallery" depth={1}>
  <h1>Book a table</h1>

  <section class="quick-info band-dark">
    <h2>Reserve online</h2>
    <p>
      Pick an area, a time, and a party size, and get instant confirmation.
    </p>
    <p>
      <a class="btn-outline" href="https://obee.com.au/tilleysdevinecafegallery/">Book a table online &rarr;</a>
    </p>
  </section>

  <section>
    <h2>Or call</h2>
    <p>
      Same-day reservations aren't accepted online or by phone &mdash; call
      ahead for another day.
    </p>
    <p><a href="tel:+61262477753">(02) 6247 7753</a></p>
  </section>

  <section>
    <h2>Before you book</h2>
    <p>
      Check the <a href="../">hours</a> for the day you want, and
      know your party size &mdash; the kitchen stops taking orders 30 minutes
      before close, and Tilley's is closed on public holidays.
    </p>
    <p>
      Walk-ins are welcome too; order at the bar and note your table number
      once you're seated. See the <a href="../menu/">menu</a> in the
      meantime.
    </p>
  </section>
</BaseLayout>
